{
  "info": {
    "name": "Research Opportunity Portal API",
    "description": "Run the requests in order (1 to 10). Start the backend first: cd backend && npm start.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Create opportunity 1",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/opportunities",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "opportunities"
          ]
        },
        "description": "Creates a research opportunity and stores its id in a collection variable.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Deep Learning for Medical Imaging\",\n  \"description\": \"Segment CT and MRI scans using transformer models.\",\n  \"research_area\": \"Artificial Intelligence\",\n  \"faculty_name\": \"Dr. Tariq Rahim\",\n  \"department\": \"Computer Science\",\n  \"required_skills\": \"Python, PyTorch, OpenCV\",\n  \"available_positions\": 2,\n  \"application_deadline\": \"2026-12-15\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201 Created\", () => pm.response.to.have.status(201));",
              "const d = pm.response.json();",
              "pm.test(\"Returns the new record with an id\", () => pm.expect(d).to.have.property(\"id\"));",
              "pm.collectionVariables.set(\"id1\", String(d.id));"
            ]
          }
        }
      ]
    },
