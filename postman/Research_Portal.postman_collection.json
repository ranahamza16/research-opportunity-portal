    {
      "name": "5. Get one opportunity (by id)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/opportunities/{{id1}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "opportunities",
            "{{id1}}"
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200 OK\", () => pm.response.to.have.status(200));",
              "pm.test(\"Correct record returned\", () => pm.expect(String(pm.response.json().id)).to.eql(pm.collectionVariables.get(\"id1\")));"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Update an opportunity (title, skills, positions, deadline)",
      "request": {
