          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "opportunities",
            "{{id1}}"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Deep Learning for Medical Imaging (Phase 2)\",\n  \"required_skills\": \"Python, PyTorch, OpenCV, Docker\",\n  \"available_positions\": 4,\n  \"application_deadline\": \"2027-01-31\"\n}",
          "options": {
