          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200 OK\", () => pm.response.to.have.status(200));",
              "const d = pm.response.json();",
              "pm.test(\"Returns an array with at least 3 items\", () => { pm.expect(d).to.be.an(\"array\"); pm.expect(d.length).to.be.at.least(3); });"
            ]
          }
