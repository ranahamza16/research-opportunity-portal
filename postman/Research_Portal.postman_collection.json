            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200 OK\", () => pm.response.to.have.status(200));",
              "const d = pm.response.json();",
              "pm.test(\"Fields were updated\", () => { pm.expect(d.available_positions).to.eql(4); pm.expect(d.title).to.include(\"Phase 2\"); });"
            ]
          }
        }
      ]
